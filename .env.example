# Asana (read-only). Without ASANA_TOKEN the portal shows sample data.
ASANA_TOKEN=

# Pilot client (one Asana project = one client)
PILOT_ASANA_PROJECT_GID=
PILOT_ACCESS_CODE=choose-a-code
PILOT_DRIVE_URL=
PILOT_WHATSAPP_GROUP_URL=

# Auth
SESSION_SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me

# Client journey manual (PDF common to every project)
NEXT_PUBLIC_MANUAL_URL=/manual
